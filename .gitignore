# Release binaries belong in GitHub Releases, never normal Git history.
*.exe
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle
*.zip
*.7z
*.rar
*.cab
*.nupkg
*.pdb

# Certificates, keys, credentials, and environment files.
*.pfx
*.p12
*.cer
*.crt
*.key
*.pem
*.jks
*.keystore
*.snk
*.sig
.env
.env.*
!.env.example
*token*
*password*
*secret*
credentials*
secrets/

# Runtime data and sensitive configuration.
storage/
backups/
private/
config.json
config.*.json
*.sqlite
*.sqlite-*
*.db
*.db-*
*.jsonl
*.log
logs/

# Buildable application source does not belong in this release repository.
*.cs
*.xaml
*.csproj
*.fsproj
*.vbproj
*.sln
*.slnx
*.rs
Cargo.toml
Cargo.lock
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
*.ts
*.tsx
*.jsx
*.py

# Build, editor, OS, and temporary output.
bin/
obj/
target/
dist/
build/
Debug/
Release/
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*

# Local staging is intentionally never committed.
release-assets/*
!release-assets/README.md
!release-assets/.gitkeep
